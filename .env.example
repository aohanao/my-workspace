# ==========================================
# 个人工作台 Supabase 云数据库配置
# 获取方式：在 Supabase 创建项目 -> Project Settings -> API
# ==========================================

# 1. 你的 Supabase 项目 URL (例如: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# 2. 你的 Supabase 匿名公钥 anon public key (例如: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 知识库服务适配层（均为服务端变量，不要添加 NEXT_PUBLIC_ 前缀）
# 留空时对应工作区显示待接入。配置值不会返回浏览器。
# RAG 服务：POST {BASE_URL}/search
KNOWLEDGE_RAG_BASE_URL=
KNOWLEDGE_RAG_API_KEY=
# 图谱服务：POST {BASE_URL}/graph
KNOWLEDGE_GRAPH_BASE_URL=
KNOWLEDGE_GRAPH_API_KEY=
# 知识问答服务：POST {BASE_URL}/chat
KNOWLEDGE_ASSISTANT_BASE_URL=
KNOWLEDGE_ASSISTANT_API_KEY=
KNOWLEDGE_ASSISTANT_MODEL=
CRON_SECRET=
