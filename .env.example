# ==========================================
# 个人工作台 Supabase 云数据库配置
# 获取方式：在 Supabase 创建项目 -> Project Settings -> API
# ==========================================

# 1. 你的 Supabase 项目 URL (例如: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# 2. 你的 Supabase 匿名公钥 anon public key (例如: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
